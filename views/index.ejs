<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL_Shortener</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
            color: #f3f4f6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: min(500px, 90vw);
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
            padding: 32px;
            backdrop-filter: blur(12px);
        }

        h1 {
            margin-top: 0;
            font-size: 2rem;
            letter-spacing: 0.04em;
            text-align: center;
        }

        form {
            display: grid;
            gap: 16px;
            margin-top: 24px;
        }

        label {
            font-size: 0.95rem;
            color: #d1d5db;
        }

        input[type="text"] {
            width: 100%;
            padding: 14px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input[type="text"]:focus {
            border-color: #8ab4f8;
            box-shadow: 0 0 0 4px rgba(138, 180, 248, 0.14);
        }

        button {
            padding: 14px 18px;
            border: none;
            border-radius: 12px;
            background: #5b8def;
            color: #fff;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        button:hover {
            background: #7c9ef3;
            transform: translateY(-1px);
        }

        p {
            margin-top: 24px;
            background: rgba(255, 255, 255, 0.08);
            padding: 16px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            word-break: break-all;
        }

        a {
            color: #e2e8f0;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        a:hover {
            opacity: 0.85;
        }

        @media (max-width: 480px) {
            .container {
                padding: 24px;
            }

            h1 {
                font-size: 1.75rem;
            }

            button, input[type="text"] {
                padding: 12px 14px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>URL Shortener</h1>
        <form action="/short" method="post">
            <label for="longUrl">Enter URL:</label>
            <input type="text" id="longUrl" name="longUrl" required>
            <button type="submit">Short</button>
        </form>
        <div id="short-url-result">
            <% if(shortURL) { %>
            <p>Short URL :- <a href="<%= shortURL %>" target="_blank" rel="noopener noreferrer"><%= shortURL %></a></p>
            <% } %>
        </div>
    </div>

    <script>
        if (window.location.search.includes('shortURL=')) {
            window.history.replaceState(null, '', window.location.pathname);
        }
    </script>
</body>
</html>